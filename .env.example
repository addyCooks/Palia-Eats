# Copy this file to .env.local and fill in the values. Never commit .env.local.

# Supabase (Project Settings -> API)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-or-publishable-key

# SERVER ONLY - never prefix with NEXT_PUBLIC_, never import in client code
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Public URL of the site (used in email links later)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Set to true after enabling Google in Supabase (shows the "Continue with Google" button)
NEXT_PUBLIC_GOOGLE_AUTH_ENABLED=false

# Signs restaurant panel links (random, 32+ characters). Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
PANEL_TOKEN_SECRET=

# Email sending (Nodemailer). Leave empty in development: emails are printed to the
# server console instead. Use any SMTP account (Gmail app password, Brevo, ...).
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
EMAIL_FROM="PaliaEats <you@example.com>"

# Protects the "unanswered order" reminder timer. Generate like PANEL_TOKEN_SECRET.
CRON_SECRET=

# WhatsApp (official Cloud API). Leave empty until the WhatsApp business account is set up;
# the app then simply skips WhatsApp. See docs/whatsapp-setup.md.
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_APP_SECRET=
WHATSAPP_VERIFY_TOKEN=
# Name of the approved message template used outside the 24-hour window (optional)
WHATSAPP_TEMPLATE_ORDER_UPDATE=
WHATSAPP_TEMPLATE_LANGUAGE=en
# Development only: print WhatsApp messages to the server console instead of sending
WHATSAPP_DRY_RUN=false
# The WhatsApp number customers message (digits with country code). Shows a WhatsApp
# ordering link on each restaurant's share card.
NEXT_PUBLIC_WHATSAPP_NUMBER=
