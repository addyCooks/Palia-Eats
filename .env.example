# Copy this file to .env.local and fill in the values. Never commit .env.local.

# Supabase (Project Settings -> API)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-or-publishable-key

# SERVER ONLY - never prefix with NEXT_PUBLIC_, never import in client code
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Public URL of the site (used in email links later)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Set to true after enabling Google in Supabase (shows the "Continue with Google" button)
NEXT_PUBLIC_GOOGLE_AUTH_ENABLED=false

# Signs restaurant panel links (random, 32+ characters). Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
PANEL_TOKEN_SECRET=

# Email sending (Nodemailer). Leave empty in development: emails are printed to the
# server console instead. Use any SMTP account (Gmail app password, Brevo, ...).
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
EMAIL_FROM="PaliaEats <you@example.com>"

# Customer and restaurant support. SUPPORT_PHONE is the support WhatsApp number (10 digits, or with
# +91). It is SERVER ONLY on purpose (no NEXT_PUBLIC_): it is never shown on a page or sent to the
# browser; the "WhatsApp us" buttons go through /support/whatsapp. Leave it empty to show only email.
# Not the ordering bot's number.
SUPPORT_PHONE=
# Optional overrides (defaults: paliaeats@gmail.com and "10 AM to 10 PM")
NEXT_PUBLIC_SUPPORT_EMAIL=
NEXT_PUBLIC_SUPPORT_HOURS=

# Where "PaliaEats hit a new problem" emails go (defaults to the support email above).
ADMIN_ALERT_EMAIL=
# Replies to order emails go here when it differs from the sender (for example a "no-reply" sender).
EMAIL_REPLY_TO=

# Order notifications on customers' phones (web push). Make a pair with:  npx web-push generate-vapid-keys
# The public key is meant to be public; keep the private key secret. Leave empty to switch push off.
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:you@example.com

# Order notifications through Firebase Cloud Messaging (free). Firebase console > Project settings:
#   General > Your apps > Web app > the config values      -> the first four lines (public, not secret)
#   Cloud Messaging > Web Push certificates > Key pair      -> NEXT_PUBLIC_FIREBASE_VAPID_KEY (public)
#   Service accounts > Generate new private key (a file)    -> FIREBASE_SERVICE_ACCOUNT (SECRET: the
#   whole file as text, or as base64). All five public values must be set for Firebase to be used;
#   leave them empty to keep using the web push keys above.
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
NEXT_PUBLIC_FIREBASE_VAPID_KEY=
FIREBASE_SERVICE_ACCOUNT=

# Optional. The database timers (see supabase/migrations/0014 and 0019) carry their own keys. This one
# lets you run a timer by hand: GET /api/cron/pending-orders with  Authorization: Bearer <this>.
# Generate like PANEL_TOKEN_SECRET.
CRON_SECRET=

# WhatsApp (official Cloud API). Leave empty until the WhatsApp business account is set up;
# the app then simply skips WhatsApp. See docs/whatsapp-setup.md.
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_APP_SECRET=
WHATSAPP_VERIFY_TOKEN=
# Name of the approved message template used outside the 24-hour window (optional)
WHATSAPP_TEMPLATE_ORDER_UPDATE=
WHATSAPP_TEMPLATE_LANGUAGE=en
# Development only: print WhatsApp messages to the server console instead of sending
WHATSAPP_DRY_RUN=false
# The WhatsApp number customers message (digits with country code). Shows a WhatsApp
# ordering link on each restaurant's share card.
NEXT_PUBLIC_WHATSAPP_NUMBER=
